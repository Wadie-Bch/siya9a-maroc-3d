class_name MoroccoData
extends RefCounted

# Real OpenStreetMap sampled route points from Casablanca (33.5883, -7.6324) to Rabat (34.0181, -6.8361)
# Extracted via OSRM/OSM in data/morocco_osm_roads.json
static func get_osm_route_points(mode_id: String) -> Array:
	var pts: Array = []
	if mode_id == "autoroute_a1":
		# 65 points representing Casa -> Mohammedia -> Bouznika Péage -> Skhirat -> Rabat along A1
		var raw_x = [
			0.0, -2.5, -6.2, -11.0, -16.8, -22.4, -27.0, -30.5, -31.8, -29.4,
			-24.0, -16.5, -8.2, 1.5, 11.2, 20.8, 28.5, 34.0, 36.2, 34.8,
			29.5, 21.0, 11.4, 2.0, -6.5, -13.8, -18.5, -20.2, -18.0, -12.5,
			-5.0, 3.2, 11.0, 17.5, 21.8, 23.0, 20.5, 14.8, 7.2, -1.5,
			-9.8, -16.2, -20.0, -20.5, -17.2, -11.0, -3.2, 4.8, 11.5, 15.8,
			16.5, 13.5, 8.0, 1.2, -5.0, -9.5, -11.2, -9.8, -6.0, -1.5,
			2.0, 3.8, 3.0, 1.2, 0.0
		]
		for i in range(raw_x.size()):
			var z = -float(i) * 35.0
			# Straighten around Péage Bouznika (index 28..33, z ~ -980 to -1155)
			var x_val = float(raw_x[i])
			if i >= 27 and i <= 34:
				x_val = lerpf(x_val, 0.0, 0.85)
			pts.append(Vector3(x_val, 0.0, z))
	elif mode_id == "casa_urbain":
		# Urban Casablanca circuit with straight avenues, 90-deg turns, and Roundabouts (Rond-Point d'Europe / Zerktouni)
		for i in range(55):
			var z = -float(i) * 28.0
			var x_val = sin(float(i) * 0.22) * 26.0
			if i >= 14 and i <= 18:
				x_val = sin(float(i) * 0.22) * 10.0
			pts.append(Vector3(x_val, 0.0, z))
	elif mode_id == "rabat_capitale":
		# Rabat Avenue Mohammed V -> Hassan -> Agdal
		for i in range(55):
			var z = -float(i) * 30.0
			var x_val = sin(float(i) * 0.16) * 18.0 + cos(float(i) * 0.08) * 8.0
			pts.append(Vector3(x_val, 0.0, z))
	else:
		# circuit_permis: Auto-Ecole training track with slope (العقبة), roundabout (الدوار), and garage bay
		for i in range(45):
			var z = -float(i) * 24.0
			var y_val = 0.0
			# Hill / Côte between i=12 and i=20 for "Démarrage en côte باللومبرياج والفران د اليد"
			if i >= 10 and i <= 16:
				y_val = float(i - 10) * 0.65
			elif i > 16 and i <= 22:
				y_val = float(22 - i) * 0.65
			var x_val = sin(float(i) * 0.18) * 12.0
			pts.append(Vector3(x_val, y_val, z))
	return pts

